# =============================================================================
# Project-specific: large data & raw outputs
# =============================================================================

# Spec folder and Claude config — local only
/spec/
.claude/

# Raw LLM responses can be large — store externally or use Git LFS
results/raw_outputs/

# Master dataset is reproducible from data/raw/ — optionally ignore
# data/prompts.jsonl

# Generated charts and result tables (reproducible from scripts)
results/tables/*.png
results/tables/*.pdf

# Scored output is reproducible from raw outputs + judge
# results/scored.jsonl

# Cache files
*.translation_cache.json
*.cache.pkl
__pycache__/

